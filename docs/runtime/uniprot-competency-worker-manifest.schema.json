{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linked-science.local/schema/uniprot-competency-worker-manifest-v1.json",
  "title": "Worker-visible UniProt competency manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "version", "corpusSnapshotDigest", "accessDate", "cases"],
  "properties": {
    "format": { "const": "linked-science-competency-worker/v1" },
    "status": { "enum": ["draft", "ready"] },
    "version": { "type": "string", "minLength": 1 },
    "corpusSnapshotDigest": { "type": "string", "pattern": "^(pending|[a-f0-9]{64})$" },
    "accessDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier", "question", "resources", "bounds", "secondTurn"],
        "properties": {
          "id": { "type": "string", "pattern": "^uq-[a-f0-9]{12}$" },
          "tier": { "type": "integer", "minimum": 0, "maximum": 5 },
          "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "profile", "authorizationRequired"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "profile": { "type": "string", "minLength": 1 },
                "authorizationRequired": { "const": true }
              }
            }
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxTransports", "maxRows", "maxCells", "maxBytes", "timeoutMs", "maxQueryChars"],
            "properties": {
              "maxTransports": { "type": "integer", "minimum": 1, "maximum": 3 },
              "maxRows": { "type": "integer", "minimum": 1, "maximum": 10 },
              "maxCells": { "type": "integer", "minimum": 1, "maximum": 100 },
              "maxBytes": { "type": "integer", "minimum": 1, "maximum": 2000000 },
              "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
              "maxQueryChars": { "type": "integer", "minimum": 1, "maximum": 16384 }
            }
          },
          "secondTurn": { "const": "question-neutral-retained-handle-reuse" }
        }
      }
    }
  }
}
