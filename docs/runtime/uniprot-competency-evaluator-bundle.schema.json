{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linked-science.local/schema/uniprot-competency-evaluator-bundle-v1.json",
  "title": "Evaluator-private UniProt competency reference bundle",
  "description": "Schema only. Evaluator data conforming to it must remain outside the worker-readable checkout and filesystem authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "corpus", "selectionSha256", "cases"],
  "properties": {
    "format": { "const": "linked-science-competency-evaluator/v1" },
    "version": { "type": "string", "minLength": 1 },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "retrievedAt", "sha256", "httpStatus", "contentType", "byteLength", "redirects"],
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "redirects": { "const": 0 },
        "etag": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceRelease": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "selectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "officialExampleId", "officialLocator", "officialQuestion", "officialQuery", "querySha256", "operation", "semanticInvariants", "rubricApplicability", "leakageMarkers"],
        "properties": {
          "id": { "type": "string", "pattern": "^uq-[a-f0-9]{12}$" },
          "officialExampleId": { "type": "string", "minLength": 1 },
          "officialLocator": { "type": "string", "format": "uri" },
          "officialQuestion": { "type": "string", "minLength": 1 },
          "officialQuery": { "type": "string", "minLength": 1 },
          "querySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operation": { "enum": ["SELECT", "ASK", "CONSTRUCT", "DESCRIBE"] },
          "semanticInvariants": {
            "type": "object",
            "additionalProperties": false,
            "required": ["graphScope", "variableRoles", "optionalValues", "cardinality", "setBag", "aggregates", "ordering"],
            "properties": {
              "graphScope": { "type": "string" },
              "variableRoles": { "type": "string" },
              "optionalValues": { "type": "string" },
              "cardinality": { "type": "string" },
              "setBag": { "type": "string" },
              "aggregates": { "type": "string" },
              "ordering": { "type": "string" }
            }
          },
          "rubricApplicability": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "applicable"],
              "properties": {
                "dimension": { "type": "integer", "minimum": 1, "maximum": 10 },
                "applicable": { "type": "boolean" },
                "reason": { "type": "string" }
              }
            }
          },
          "leakageMarkers": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "enum": ["official-example-id", "query-fragment", "expected-answer", "honeytoken"] },
                "value": { "type": "string", "minLength": 8, "maxLength": 4096 }
              }
            }
          }
        }
      }
    }
  }
}
