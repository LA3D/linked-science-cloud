{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linked-science.local/schema/linked-science-traversal-capability-v3.json",
  "title": "Linked Science anonymous Linked Data read traversal receipt",
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxQueryChars", "maxRequestBodyBytes", "maxDurationMs", "maxRequestMs", "maxRequests", "maxFanOut", "maxConcurrency", "maxResponseBytes", "maxTotalBytes", "maxResultItems"],
      "properties": {
        "maxQueryChars": { "type": "integer", "minimum": 1 },
        "maxRequestBodyBytes": { "type": "integer", "minimum": 1 },
        "maxDurationMs": { "type": "integer", "minimum": 1 },
        "maxRequestMs": { "type": "integer", "minimum": 1 },
        "maxRequests": { "type": "integer", "minimum": 1 },
        "maxFanOut": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxTotalBytes": { "type": "integer", "minimum": 1 },
        "maxResultItems": { "type": "integer", "minimum": 1 }
      }
    },
    "authority": {
      "type": "object",
      "required": ["class", "version", "anonymous", "schemes", "methods", "queryTypes", "effects", "prohibited"],
      "properties": {
        "class": { "const": "anonymous-linked-data-read" },
        "version": { "const": "1.0.0" },
        "anonymous": { "const": true },
        "schemes": { "const": ["http", "https"] },
        "methods": { "const": ["GET", "HEAD", "SPARQL_POST"] },
        "queryTypes": { "const": ["SELECT", "ASK", "CONSTRUCT", "DESCRIBE"] },
        "effects": { "type": "array", "items": { "type": "string" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "responseUrl", "links", "profiles", "profileDeclarations", "malformedLinkHeader", "truncated", "trust"],
      "properties": {
        "kind": { "const": "linked-data-navigation-evidence" },
        "responseUrl": { "type": "string", "format": "uri" },
        "links": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["target", "relations"],
            "properties": {
              "target": { "type": "string", "format": "uri" },
              "relations": { "type": "array", "items": { "type": "string" } },
              "anchor": { "type": "string", "format": "uri" },
              "parameters": { "type": "object", "maxProperties": 8 }
            }
          }
        },
        "profiles": { "type": "array", "maxItems": 24, "items": { "type": "string" } },
        "profileDeclarations": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "mechanism"],
            "properties": {
              "profile": { "type": "string" },
              "mechanism": { "enum": ["content-type", "content-profile", "link"] }
            }
          }
        },
        "preferenceApplied": { "type": "string" },
        "malformedLinkHeader": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "trust": { "const": "untrusted-candidate-evidence" }
      }
    },
    "exchange": {
      "type": "object",
      "required": ["kind", "version", "index", "status", "requestedUrl", "method", "requestSha256", "bytes", "startedAt", "finishedAt", "retries"],
      "properties": {
        "kind": { "const": "linked-science-fetch-exchange" },
        "version": { "const": "3.2.0" },
        "index": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["success", "http-error", "failure"] },
        "requestedUrl": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "redirected": { "type": "boolean" },
        "method": { "enum": ["GET", "HEAD", "POST"] },
        "httpStatus": { "type": "integer" },
        "requestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "responseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string" },
        "headers": { "type": "object" },
        "responseHeadersTruncated": { "type": "boolean" },
        "navigation": { "$ref": "#/$defs/navigation" },
        "queryType": { "enum": ["SELECT", "ASK", "CONSTRUCT", "DESCRIBE"] },
        "querySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "retries": { "const": 0 },
        "failure": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } }
      }
    }
  },
  "type": "object",
  "required": ["kind", "version", "authority", "status", "traversalId", "budgets", "usage", "exchanges", "redirectEvidence"],
  "properties": {
    "kind": { "const": "linked-science-traversal-receipt" },
    "version": { "const": "3.2.0" },
    "authority": { "$ref": "#/$defs/authority" },
    "status": { "enum": ["active", "complete", "failed", "aborted"] },
    "traversalId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string" },
    "observedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "usage": {
      "type": "object",
      "required": ["requests", "fanOut", "bytes", "retries"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "fanOut": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "retries": { "const": 0 }
      }
    },
    "exchanges": { "type": "array", "items": { "$ref": "#/$defs/exchange" } },
    "redirectEvidence": { "const": "requested-final-and-redirected-flag" },
    "failure": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } }
  }
}
