PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX up: <http://purl.uniprot.org/core/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?mechanism ?sourceGene ?protein ?proteinName ?organism WHERE { ?mechanism a dm:Pathophysiology; dm:genes/dm:term ?sourceGene . FILTER(CONTAINS(STR(?sourceGene),"hgnc_id/")) BIND(IRI(CONCAT("http://purl.uniprot.org/hgnc/",STRAFTER(STR(?sourceGene),"hgnc_id/"))) AS ?xref) ?protein a up:Protein; rdfs:seeAlso ?xref; up:recommendedName/up:fullName ?proteinName; up:organism ?organism }
