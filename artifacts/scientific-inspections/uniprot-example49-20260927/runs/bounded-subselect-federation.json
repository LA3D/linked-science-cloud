  "query": "PREFIX CHEBI: <http://purl.obolibrary.org/obo/CHEBI_>\nPREFIX genex: <http://purl.org/genex#>\nPREFIX lscr: <http://purl.org/lscr#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX rh: <http://rdf.rhea-db.org/>\nPREFIX taxon: <http://purl.uniprot.org/taxonomy/>\nPREFIX up: <http://purl.uniprot.org/core/>\nSELECT DISTINCT ?chebi ?reaction ?protein ?ensemblGene ?anatomicEntity ?anatomicEntityLabel WHERE {\n SERVICE <https://sparql.uniprot.org/sparql> { SELECT DISTINCT ?protein ?reaction ?ensemblGene WHERE {\n VALUES ?protein {<http://purl.uniprot.org/uniprot/P22680>}\n ?protein up:organism taxon:9606; up:annotation ?a; rdfs:seeAlso/up:transcribedFrom ?ensemblGeneVersioned .\n ?a a up:Catalytic_Activity_Annotation; up:catalyticActivity/up:catalyzedReaction ?reaction .\n BIND(IRI(REPLACE(STR(?ensemblGeneVersioned), \"[.][0-9]+$\", \"\")) AS ?ensemblGene)\n }\n } SERVICE <https://sparql.rhea-db.org/sparql> { SELECT DISTINCT ?reaction ?chebi WHERE {\n VALUES ?reaction {<http://rdf.rhea-db.org/21812>}\n ?reaction rdfs:subClassOf rh:Reaction; rh:equation ?equation; rh:side/rh:contains/rh:compound/rh:chebi ?chebi .\n VALUES ?chebi { CHEBI:16113 }\n }\n } SERVICE <https://www.bgee.org/sparql/> { SELECT DISTINCT ?ensemblGene ?anatomicEntity ?anatomicEntityLabel WHERE {\n VALUES ?ensemblGene {<http://rdf.ebi.ac.uk/resource/ensembl/ENSG00000167910>}\n ?gene lscr:xrefEnsemblGene ?ensemblGene; genex:isExpressedIn ?anatomicEntity .\n ?anatomicEntity rdfs:label ?anatomicEntityLabel .\n }\n}}",
