PREFIX CHEBI: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX genex: <http://purl.org/genex#>
PREFIX lscr: <http://purl.org/lscr#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX up: <http://purl.uniprot.org/core/>
SELECT DISTINCT ?chebi ?reaction ?protein ?ensemblGene ?anatomicEntity ?anatomicEntityLabel WHERE {
 SERVICE <https://sparql.uniprot.org/sparql> {
 VALUES ?protein {<http://purl.uniprot.org/uniprot/P22680>}
 ?protein up:organism taxon:9606; up:annotation ?a; rdfs:seeAlso/up:transcribedFrom ?ensemblGeneVersioned .
 ?a a up:Catalytic_Activity_Annotation; up:catalyticActivity/up:catalyzedReaction ?reaction .
 BIND(IRI(REPLACE(STR(?ensemblGeneVersioned), "[.][0-9]+$", "")) AS ?ensemblGene)
 }
 SERVICE <https://sparql.rhea-db.org/sparql> {
 VALUES ?reaction {<http://rdf.rhea-db.org/21812>}
 ?reaction rdfs:subClassOf rh:Reaction; rh:equation ?equation; rh:side/rh:contains/rh:compound/rh:chebi ?chebi .
 ?chebi rdfs:subClassOf* CHEBI:16113 .
 }
 SERVICE <https://www.bgee.org/sparql/> {
 VALUES ?ensemblGene {<http://rdf.ebi.ac.uk/resource/ensembl/ENSG00000167910>}
 ?gene lscr:xrefEnsemblGene ?ensemblGene; genex:isExpressedIn ?anatomicEntity .
 ?anatomicEntity rdfs:label ?anatomicEntityLabel .
 }
}
