PREFIX CHEBI: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX genex: <http://purl.org/genex#>
PREFIX lscr: <http://purl.org/lscr#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX up: <http://purl.uniprot.org/core/>
SELECT DISTINCT ?protein ?ca ?reaction ?p ?o WHERE { VALUES ?protein {<http://purl.uniprot.org/uniprot/P06280>} ?protein up:organism taxon:9606; up:annotation/up:catalyticActivity ?ca . ?ca up:catalyzedReaction ?reaction; ?p ?o . }
