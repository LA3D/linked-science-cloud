PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX app: <urn:fabry-full-graph:> SELECT ?mechanism ?cell ?cellLabel ?cellParent ?parentLabel ?location ?locationLabel ?reference ?support ?snippet WHERE { ?mechanism a dm:Pathophysiology; dm:cell_types/dm:term ?cell; dm:locations/dm:term ?location; dm:evidence ?e . FILTER(?cell=obo:CL_0000653 && ?location=obo:UBERON_0002113) ?e dm:reference ?reference; dm:supports ?support; dm:snippet ?snippet . ?cell rdfs:label ?cellLabel; rdfs:subClassOf ?cellParent . ?cellParent rdfs:label ?parentLabel . ?location rdfs:label ?locationLabel . }
