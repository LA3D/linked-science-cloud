PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX app: <urn:fabry-full-graph:> SELECT (COUNT(?edge) AS ?edges) (COUNT(?target) AS ?resolved) WHERE { ?edge a dm:CausalEdge . OPTIONAL { ?edge app:resolvedTarget ?target } }
