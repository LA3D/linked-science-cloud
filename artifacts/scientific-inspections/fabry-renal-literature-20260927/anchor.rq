PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX app: <urn:fabry-full-graph:> SELECT ?mechanism ?name ?chemical WHERE { VALUES ?chemical {obo:CHEBI_18313} ?mechanism dm:chemical_entities/dm:term ?chemical; app:sourceName ?name . }
