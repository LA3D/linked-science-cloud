PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX app: <urn:fabry-full-graph:> SELECT ?child ?childLabel ?parent ?parentLabel WHERE { obo:CL_0000653 rdfs:subClassOf* ?child . ?child rdfs:subClassOf ?parent; rdfs:label ?childLabel . ?parent rdfs:subClassOf* obo:CL_0002518; rdfs:label ?parentLabel . }
