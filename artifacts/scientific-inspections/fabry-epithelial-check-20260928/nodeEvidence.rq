PREFIX dm: <https://w3id.org/monarch-initiative/dismech/> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX app: <urn:fabry-full-graph:> SELECT DISTINCT ?name ?e ?reference ?support ?snippet WHERE { ?m app:sourceName ?name; dm:cell_types/dm:term ?cell; dm:locations/dm:term obo:UBERON_0002113; dm:evidence ?e . ?cell rdfs:subClassOf* obo:CL_0002518 . ?e dm:reference ?reference; dm:snippet ?snippet . OPTIONAL {?e dm:supports ?support} }
