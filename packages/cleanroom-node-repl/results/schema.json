{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/node-repl-network-probe/result.schema.json",
  "title": "Node REPL network comparison result",
  "type": "object",
  "required": [
    "schemaVersion",
    "capturedAt",
    "context",
    "freshTask",
    "taskSource",
    "sandboxImplementation",
    "sandboxMode",
    "persistence",
    "shell",
    "nodeRepl",
    "classification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string" },
    "context": {
      "enum": [
        "projectless",
        "trusted-project-local",
        "trusted-project-worktree",
        "codex-cli",
        "full-access-optional"
      ]
    },
    "freshTask": { "const": true },
    "projectTrusted": { "enum": ["yes", "no", "not-applicable", "unknown"] },
    "taskSource": { "type": "string", "maxLength": 80 },
    "sandboxImplementation": { "type": "string", "maxLength": 80 },
    "sandboxMode": { "type": "string", "maxLength": 80 },
    "persistence": {
      "type": "object",
      "required": ["tokenLabel", "persistedAcrossCalls"],
      "properties": {
        "tokenLabel": { "type": "string", "maxLength": 80 },
        "persistedAcrossCalls": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shell": { "$ref": "#/$defs/surface" },
    "nodeRepl": { "$ref": "#/$defs/surface" },
    "classification": {
      "enum": [
        "both-fail",
        "shell-succeeds-repl-fails",
        "http-succeeds-raw-sockets-fail",
        "local-succeeds-worktree-fails",
        "only-full-access-succeeds",
        "both-succeed",
        "inconclusive"
      ]
    },
    "notes": { "type": "string", "maxLength": 500 }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["probe"],
      "properties": {
        "probe": { "type": ["object", "null"] },
        "commandExitCode": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
