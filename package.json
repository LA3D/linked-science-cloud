{
  "name": "@linked-science/runtime",
  "private": true,
  "version": "0.0.0",
  "description": "Authoritative Linked Science runtime and project-owned persistent REPL broker",
  "linkedScience": {
    "repositoryRole": "authoritative-production-implementation",
    "bootstrapEntrypoint": "lib/cleanroom-linked-science-bootstrap.mjs",
    "broker": {
      "packageName": "@linked-science/cleanroom-node-repl",
      "packageRoot": "packages/cleanroom-node-repl",
      "entrypoint": "packages/cleanroom-node-repl/src/cleanroom-mcp.mjs",
      "mcpServer": "cleanroom_node_repl",
      "tools": [
        "js",
        "js_reset",
        "js_add_node_module_dir"
      ]
    }
  },
  "type": "module",
  "scripts": {
    "codex:configure": "node scripts/configure-project-mcp.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/validate-repository-boundaries.mjs && node --test",
    "boundaries:validate": "node scripts/validate-repository-boundaries.mjs",
    "linked-science:verify": "node scripts/validate-repository-boundaries.mjs && npm run cleanroom:check && node scripts/cleanroom-linked-science-synthetic.mjs",
    "cleanroom:check": "npm --prefix packages/cleanroom-node-repl run check",
    "cleanroom:test": "npm --prefix packages/cleanroom-node-repl test",
    "experiment:context-map": "node scripts/context-map-recovery.mjs",
    "experiment:context-map-two-turn": "node scripts/context-map-two-turn-turn1.mjs",
    "experiment:context-map-two-turn-turn2": "node scripts/context-map-two-turn-turn2.mjs",
    "session:synthetic": "node scripts/repl-session-synthetic.mjs",
    "runtime:synthetic": "node scripts/linked-science-runtime-synthetic.mjs",
    "runtime:cleanroom-synthetic": "node scripts/cleanroom-linked-science-synthetic.mjs",
    "evaluation:results:validate": "node scripts/validate-experiment-results.mjs",
    "affordances:demo": "node scripts/affordance-catalog-demo.mjs",
    "evaluation:uniprot:validate": "node scripts/validate-uniprot-competency-manifest.mjs"
  },
  "dependencies": {
    "@comunica/query-sparql": "^5.3.0",
    "http-link-header": "^1.1.4",
    "n3": "^2.2.0",
    "sparqlalgebrajs": "^5.0.2",
    "sparqljs": "^3.7.4"
  }
}
