default_permissions = "node-repl-network-probe"

[features]
network_proxy = true

[permissions.node-repl-network-probe]
description = "Workspace-only diagnostic access to example.com."
extends = ":workspace"

[permissions.node-repl-network-probe.network]
enabled = true

[permissions.node-repl-network-probe.network.domains]
"example.com" = "allow"
