{
  "apiVersion": "linked-data-repl/v1",
  "kind": "EvidencePack",
  "metadata": { "id": "uniprot", "version": "2026-08-15", "title": "UniProt Linked Data" },
  "resources": [
    { "id": "ontology", "role": "ontology", "uri": "https://purl.uniprot.org/core/", "authority": "canonical", "retrievalPolicy": "mediated-public-https-linked-data", "mediaTypes": ["text/turtle", "application/rdf+xml"] },
    { "id": "examples", "role": "query-examples", "uri": "https://sparql.uniprot.org/.well-known/sparql-examples/", "authority": "official", "retrievalPolicy": "user-approved-web", "mediaTypes": ["text/html"] },
    { "id": "graph-description", "role": "dataset-description", "uri": "https://sparql.uniprot.org/uniprot", "authority": "canonical", "retrievalPolicy": "user-approved-web", "mediaTypes": ["text/html"] }
  ],
  "access": { "mode": "mediated-public-https-linked-data", "authorizationRequired": true, "endpointAllowlist": false },
  "declarations": { "namedGraphs": [{ "iri": "http://sparql.uniprot.org/uniprot", "evidence": { "resource": "graph-description", "locator": "Named graph" } }] }
}
