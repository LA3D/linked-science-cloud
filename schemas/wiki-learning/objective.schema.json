{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Linked Science wiki-learning objective v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "previousId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 128
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "previousId",
    "eventId",
    "statement",
    "acceptance"
  ],
  "additionalProperties": false
}
