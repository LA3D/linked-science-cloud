{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Linked Science wiki-learning outcome v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "objectiveId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "kind": {
      "enum": [
        "machine-check",
        "user-judgment",
        "agent-judgment"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "unknown"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "missingEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "objectiveId",
    "kind",
    "status",
    "claim",
    "evidenceIds",
    "missingEvidence"
  ],
  "additionalProperties": false
}
